# docker compose 가 읽는 자격증명. 기본값(bim / minio123)은 로컬 개발용 — 외부 배포 전 반드시 바꾼다.
POSTGRES_PASSWORD=bim
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
# 외부에 데모를 열 때: 둘 다 채우면 web(nginx)이 화면·API·glb 전부에 Basic 인증을 건다. 비우면 로컬처럼 열림
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# 아래는 compose.yaml 이 api·ifc-worker 컨테이너에 넣는 값(직접 실행할 때만 필요). 괄호는 기본값.
#   DB_HOST (localhost)            PostgreSQL 호스트. 사용자·DB 이름은 bim 고정
#   DB_PASSWORD (bim)              = POSTGRES_PASSWORD
#   S3_ENDPOINT (http://localhost:9000)  MinIO 주소. scheme 이 https 면 워커도 TLS 로 붙는다
#   S3_ACCESS_KEY / S3_SECRET_KEY  = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
#   GEOM_THREADS (CPU 수)          워커 기하 변환 스레드. 스레드당 메모리 ~200MB
#   JOB_HEARTBEAT_SEC (30)         워커 lease heartbeat 간격(초)
